{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GoldScope: Run Server",
      "type": "shell",
      "command": "python3 app.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "HOST": "127.0.0.1",
          "PORT": "8000",
          "PYTHONPYCACHEPREFIX": "/tmp/goldscope-pycache"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "GoldScope: Run Tests",
      "type": "shell",
      "command": "python3 -m unittest -v",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPYCACHEPREFIX": "/tmp/goldscope-pycache"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "GoldScope: Check JavaScript",
      "type": "shell",
      "command": "node --check static/app.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "GoldScope: Build Liara ZIP",
      "type": "shell",
      "command": "mkdir -p outputs && zip -FS -r outputs/goldscope-liara.zip VERSION CHANGELOG.md app.py main.py liara.json requirements.txt README.md LIARA_DEPLOY_FA.md static seed",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
